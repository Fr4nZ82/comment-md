{
  "name": "comment-md",
  "displayName": "Comment MD",
  "description": "Preview Markdown files with persistent per-selection comments and Mermaid support.",
  "version": "0.1.0",
  "publisher": "Fr4nZ82",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fr4nZ82/comment-md.git"
  },
  "bugs": {
    "url": "https://github.com/Fr4nZ82/comment-md/issues"
  },
  "homepage": "https://github.com/Fr4nZ82/comment-md#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown preview",
    "comment",
    "comments",
    "annotation",
    "annotate",
    "review",
    "code review",
    "mermaid",
    "claude",
    "claude code",
    "anthropic",
    "copilot",
    "github copilot",
    "chat",
    "llm",
    "ai",
    "feedback"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commentMd.openPreview",
        "title": "Open Comment Preview",
        "category": "Comment MD"
      },
      {
        "command": "commentMd.submit",
        "title": "Submit All Comments",
        "category": "Comment MD"
      }
    ],
    "customEditors": [
      {
        "viewType": "commentMd.preview",
        "displayName": "Comment MD Preview",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "commentMd.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "commentMd.submit",
          "when": "commentMd.previewOpen"
        }
      ],
      "editor/title": [
        {
          "command": "commentMd.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "commentMd.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "command": "commentMd.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile && node ./scripts/copy-mermaid.js",
    "postinstall": "node ./scripts/copy-mermaid.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "mermaid": "^10.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.5"
  }
}
